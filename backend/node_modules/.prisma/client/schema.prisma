generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS DE PERFIS E STATUS
// ==========================================

enum UserRole {
  ALUNO
  PROFESSOR
  COPER
  EMPRESARIO
  CIVIL
}

enum DonationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  FINISHED
}

enum EnrollmentStatus {
  ACTIVE
  WAITLIST
  CANCELLED
  COMPLETED
  FAILED
}

enum DocType {
  DONATION_DECLARATION
  COURSE_CERTIFICATE
}

enum CampaignStatus {
  ACTIVE
  FUTURE
  CLOSED
}

// ==========================================
// MODELOS PRINCIPAIS
// ==========================================

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  cpf                String   @unique
  passwordHash       String   @map("password_hash")
  role               UserRole @default(CIVIL)
  matricula          String?  @unique
  address            String?
  phone              String?
  isActive           Boolean  @default(true) @map("is_active")
  semesterHoursLimit Float?   @map("semester_hours_limit")
  totalHoursEarned   Float    @default(0) @map("total_hours_earned")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  donations           Donation[]           @relation("UserDonations")
  validatedDonations  Donation[]           @relation("ValidatorDonations")
  receivedDonations   Donation[]           @relation("ReceiverDonations")
  coursesTaught       Course[]             @relation("InstructorCourses")
  enrollments         Enrollment[]         @relation("StudentEnrollments")
  attendances         Attendance[]         @relation("StudentAttendances")
  certificates        Certificate[]        @relation("UserCertificates")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([cpf])
  @@index([email])
  @@index([role])
  @@index([matricula])
  @@map("users")
}

model Donation {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  user              User           @relation("UserDonations", fields: [userId], references: [id], onDelete: Cascade)
  status            DonationStatus @default(PENDING)
  validatedByUserId String?        @map("validated_by_user_id")
  validatedBy       User?          @relation("ValidatorDonations", fields: [validatedByUserId], references: [id])
  hoursEarned       Float          @default(0) @map("hours_earned")
  authHash          String         @unique @default(uuid()) @map("auth_hash")
  rejectionReason   String?        @map("rejection_reason")
  evidenceUrl       String?        @map("evidence_url")
  campaignId        String?        @map("campaign_id")
  campaign          Campaign?      @relation(fields: [campaignId], references: [id])
  receivedById      String?        @map("received_by_id")
  receivedBy        User?          @relation("ReceiverDonations", fields: [receivedById], references: [id])
  donorName         String?        @map("donor_name")
  donorCpf          String?        @map("donor_cpf")
  observation       String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  items       DonationItem[]
  certificate Certificate?

  @@index([authHash])
  @@index([status])
  @@index([userId])
  @@index([validatedByUserId])
  @@index([campaignId])
  @@index([receivedById])
  @@map("donations")
}

model DonationItem {
  id          String   @id @default(uuid())
  donationId  String   @map("donation_id")
  donation    Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  description String
  category    String // Ex: ALIMENTOS, HIGIENE, ROUPAS, LIVROS, MATERIAIS
  quantity    Float
  unit        String?  @default("unidades")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([donationId])
  @@index([category])
  @@map("donation_items")
}

model Campaign {
  id              String         @id @default(uuid())
  title           String
  description     String
  status          CampaignStatus @default(ACTIVE)
  startDate       DateTime?      @map("start_date")
  endDate         DateTime?      @map("end_date")
  hoursLimit      Float?         @map("hours_limit")
  conversionRules String?        @map("conversion_rules")
  isUrgent        Boolean        @default(false) @map("is_urgent")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  priorityItems PriorityItem[]
  donations     Donation[]

  @@map("campaigns")
}

model PriorityItem {
  id           String   @id @default(uuid())
  campaignId   String   @map("campaign_id")
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  goal         Float?
  urgencyLevel String   @default("NORMAL") @map("urgency_level")
  isUrgent     Boolean  @default(false) @map("is_urgent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("priority_items")
}

model Course {
  id               String       @id @default(uuid())
  title            String
  description      String
  instructorId     String       @map("instructor_id")
  instructor       User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  workloadHours    Int          @map("workload_hours")
  minAttendancePct Float        @default(75.0) @map("min_attendance_pct")
  status           CourseStatus @default(OPEN)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  classrooms Classroom[]

  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Classroom {
  id                   String       @id @default(uuid())
  courseId             String       @map("course_id")
  course               Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code                 String?
  maxCapacity          Int          @map("max_capacity")
  startDate            DateTime     @map("start_date")
  endDate              DateTime     @map("end_date")
  enrollmentStartDate  DateTime?    @map("enrollment_start_date")
  enrollmentEndDate    DateTime?    @map("enrollment_end_date")
  cancellationDeadline DateTime?    @map("cancellation_deadline")
  minGrade             Float        @default(7.0) @map("min_grade")
  status               CourseStatus @default(OPEN)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  enrollments Enrollment[]
  attendances Attendance[]

  @@index([courseId])
  @@index([status])
  @@map("classrooms")
}

model Enrollment {
  id                   String           @id @default(uuid())
  classroomId          String           @map("classroom_id")
  classroom            Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId            String           @map("student_id")
  student              User             @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  status               EnrollmentStatus @default(ACTIVE)
  waitlistPosition     Int?             @map("waitlist_position")
  attendancePercentage Float?           @map("attendance_percentage")
  gradeA1              Float?           @map("grade_a1")
  gradeA2              Float?           @map("grade_a2")
  gradeA3              Float?           @map("grade_a3")
  finalGrade           Float?           @map("final_grade")
  enrolledAt           DateTime         @default(now()) @map("enrolled_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  certificate Certificate?

  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
  @@index([status])
  @@index([waitlistPosition])
  @@map("enrollments")
}

model Attendance {
  id          String    @id @default(uuid())
  classroomId String    @map("classroom_id")
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String    @map("student_id")
  student     User      @relation("StudentAttendances", fields: [studentId], references: [id], onDelete: Cascade)
  classDate   DateTime  @map("class_date")
  isPresent   Boolean   @default(false) @map("is_present")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([classroomId, studentId, classDate])
  @@index([classroomId])
  @@index([studentId])
  @@index([classDate])
  @@map("attendances")
}

model Certificate {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  type          DocType
  authHash      String   @unique @default(uuid()) @map("auth_hash")
  validationUrl String   @map("validation_url")
  title         String
  description   String?
  hours         Float?
  metadata      Json?
  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  donationId String?   @unique @map("donation_id")
  donation   Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)

  enrollmentId String?     @unique @map("enrollment_id")
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([authHash])
  @@index([userId])
  @@index([type])
  @@map("certificates")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}
