# ==============================================================================
# SISTEMA COPER 3.0 | ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# Servidor Backend
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Banco de Dados Relacional (PostgreSQL 16 via Docker ou Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coper_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coper_db?schema=public"

# Cache e Fila em Memória (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PgAdmin 4 (Interface Web do Banco de Dados)
PGADMIN_DEFAULT_EMAIL=admin@coper.edu.br
PGADMIN_DEFAULT_PASSWORD=admin123

# Autenticação JWT e Segurança (Tokens de Acesso e Refresh)
JWT_SECRET=coper_3_0_super_secret_jwt_access_key_2026_educational_fmp
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=coper_3_0_super_secret_jwt_refresh_key_2026_auth_rotation
JWT_REFRESH_EXPIRES_IN=7d

# Administrador Padrão do Sistema (Seed)
DEFAULT_ADMIN_NAME="Coordenador Geral COPER"
DEFAULT_ADMIN_EMAIL=coper@coper.edu.br
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_CPF=00011122233

# Serviço de Envio de E-mails Transacionais (SMTP / Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="COPER 3.0 <notificacoes@coper.edu.br>"
