# ==============================================================================
# GESTÃO DE DOAÇÕES — BACKEND Node.js/Express | .env.example
# ==============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Opção 1: URL completa (produção — Render, Railway, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host:5432/db_gestaodedoacao?sslmode=require

# Opção 2: Variáveis individuais (desenvolvimento local — usado quando DATABASE_URL não estiver definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=db_gestaodedoacao

# ── Autenticação JWT ──────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOADS_DIR=uploads
