{
  "name": "coper-backend",
  "version": "3.0.0",
  "description": "Sistema COPER 3.0 - API Backend em Node.js com TypeScript, Clean Architecture e Prisma ORM",
  "main": "dist/presentation/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/presentation/server.js",
    "dev": "tsx watch src/presentation/server.ts",
